# VisionGuard environment. Copy to `.env` and fill in. NEVER commit `.env` or real keys.
# Grouped by the slice that first needs each value.

# ── App (Slice 0) ─────────────────────────────────────────────────────────────
APP_ENV=dev                    # dev | test | staging | production
# AUTH_TEST_MODE bypasses Clerk JWT verification with a signed test identity.
# The app REFUSES TO START if this is 1 and APP_ENV is not dev/test.
AUTH_TEST_MODE=0
# Comma-separated origins allowed as the Clerk token `azp` claim, and for CORS.
# When set, a token's `azp` MUST be present and in this list (absence is rejected).
# Must not be '*' outside dev/test. Leave blank only to disable the azp origin check.
ALLOWED_ORIGINS=http://localhost:5173

# ── Database — Postgres/Supabase (Slice 0) ────────────────────────────────────
# Local docker default (host port 5433); for Supabase use the Session pooler string.
DATABASE_URL=postgresql+psycopg://visionguard:visionguard@localhost:5433/visionguard
SUPABASE_URL=                  # https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=     # service role key (server-side only)

# ── Auth — Clerk (Slice 0) ────────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=              # https://<subdomain>.clerk.accounts.dev
CLERK_JWKS_URL=                # <issuer>/.well-known/jwks.json
CLERK_AUDIENCE=                # optional; leave blank if not configured in Clerk

# ── Redis — Upstash (Slice 3; needed for worker) ──────────────────────────────
REDIS_URL=redis://localhost:6380/0   # local docker (host port 6380); Upstash uses rediss://

# ── Object storage — S3-compatible (Slice 2 documents) ───────────────────────
# STORAGE_BACKEND: "s3" (MinIO in dev / R2 in prod) or "fake" (in-memory; used by tests/CI).
STORAGE_BACKEND=s3
# Dev uses local MinIO (docker-compose). Production points these at Cloudflare R2:
#   STORAGE_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
#   STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY = R2 API token
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=vg-assets
STORAGE_REGION=us-east-1
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_UPLOAD_BYTES=15000000

# ── Evidence capture (Slice 7) ────────────────────────────────────────────────
# CAPTURE_BACKEND: "playwright" (needs the [capture] extra) or "fake" (tests/CI).
# TSA_BACKEND: "rfc3161" (needs [capture]) or "fake". Evidence lives in a SEPARATE, write-once,
# object-locked bucket. Dev MinIO: created with versioning + object lock (GOVERNANCE, ~1 day).
# Production R2: long retention below.
CAPTURE_BACKEND=playwright
TSA_BACKEND=rfc3161
STORAGE_EVIDENCE_BUCKET=vg-evidence
EVIDENCE_OBJECT_LOCK_MODE=GOVERNANCE
EVIDENCE_RETENTION_DAYS=365
EVIDENCE_FRESHNESS_DAYS=7

# ── CSAM scanning gate (CLAUDE.md #7) ─────────────────────────────────────────
# Every open-web/uploaded image must pass a `clean` scan before any bytes are stored/sealed.
# "none" (default) fails closed → nothing stored until a real scanner is wired. "fake" is
# dev/test-ONLY (the app refuses to start with fake outside dev/test). A real PhotoDNA/Safer
# backend is added later behind the same interface.
CSAM_SCANNER_BACKEND=none
# CSAM_FAKE_RESULT=clean   # fake backend only: clean | match | error

# ── Assets & fingerprinting (Slice 3) ─────────────────────────────────────────
ASSET_MAX_UPLOAD_BYTES=25000000
# EMBEDDER_BACKEND: "clip" needs the [ml] extra (pip install -e '.[ml]'); "fake" for CI/tests.
EMBEDDER_BACKEND=clip
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
THUMBNAIL_MAX_PX=256

# Legacy R2 references (Slice 7 evidence bucket uses object lock)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ASSETS_BUCKET=vg-assets
R2_EVIDENCE_BUCKET=vg-evidence       # object-lock enabled bucket

# ── Discovery providers + fetcher (Slice 4) ───────────────────────────────────
SERPAPI_KEY=
TINEYE_API_KEY=                # optional; TinEye is also gated by a per-workspace flag
# PROVIDER_BACKEND: "serpapi" (real) or "fake" (tests/CI). FETCHER_BACKEND: "safe" or "fake".
PROVIDER_BACKEND=serpapi
FETCHER_BACKEND=safe
FETCHER_TIMEOUT_SECONDS=10
FETCHER_MAX_BYTES=10000000
FETCHER_MAX_REDIRECTS=3
DISCOVERY_DEFAULT_MONTHLY_BUDGET=500

# ── Review & matching (Slice 5) ───────────────────────────────────────────────
# Score thresholds/weights and the leak-domain + risky-keyword lists live here (not in code)
# so ops can tune them without a deploy. REVIEW_LEAK_DOMAINS / REVIEW_RISKY_KEYWORDS are
# comma-separated. Replace the example leak domains with the real tube/leak host list.
REVIEW_PHASH_EXACT_MAX=6
REVIEW_PHASH_NEAR_MAX=16
REVIEW_EMBEDDING_MATCH_THRESHOLD=0.80
REVIEW_LEAK_DOMAINS=leak-tube.example,leaks.example
REVIEW_RISKY_KEYWORDS=leaked,leak,free,onlyfans,nude,nudes,stolen,xxx
REVIEW_BULK_DISMISS_MAX=500

# ── Email & notices — SendGrid (Slice 8) ──────────────────────────────────────
# EMAIL_BACKEND: "outbox" (default) captures messages and never sends — dev/test can never
# send real mail. "sendgrid" sends via SendGrid and is allowed ONLY when APP_ENV is production
# (and requires SENDGRID_API_KEY + EMAIL_FROM); the app refuses to start otherwise.
EMAIL_BACKEND=outbox
SENDGRID_API_KEY=
EMAIL_FROM=notices@visionguard.example
EMAIL_REPLY_TO=
EMAIL_RATE_LIMIT_PER_MIN=30

# ── Billing — Stripe (Slice 13) ───────────────────────────────────────────────
# BILLING_BACKEND: "fake" (default) records calls in-memory and NEVER talks to Stripe — dev/test
# only. "stripe" talks to Stripe and is REQUIRED in deployments. Production must use LIVE keys
# (sk_live_…); staging must use TEST keys (sk_test_…); a live key is refused outside production.
# All PRICING lives on Stripe Price objects referenced below — the app never computes amounts
# (unit price, the 15%-off-at-20 VOLUME tier, and the 2-months-free ANNUAL prices are all defined
# on the Price objects in Stripe).
BILLING_BACKEND=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CORE_MONTHLY=
STRIPE_PRICE_CORE_ANNUAL=
STRIPE_PRICE_PRIORITY_MONTHLY=
STRIPE_PRICE_PRIORITY_ANNUAL=
STRIPE_PRICE_ONBOARDING_AUDIT=
STRIPE_COUPON_DESIGN_PARTNER=
# The Billing-Portal CONFIGURATION id (created via the Stripe API) that DISABLES quantity changes
# and plan switching — customers get card/ACH/invoice management + cancellation only. Quantity is
# derived server-side from the active-subject count; plan changes go through staff.
STRIPE_PORTAL_CONFIGURATION_ID=
# Pass automatic_tax to Checkout. Leave off until sales-tax nexus/registration is confirmed, so we
# never collect tax we aren't registered to remit.
STRIPE_AUTOMATIC_TAX=0
BILLING_MIN_QUANTITY=5         # subscription quantity floor (per-subject plans)
BILLING_GRACE_DAYS=14          # past_due grace period before suspension

# ── Production readiness (Slice 11) ───────────────────────────────────────────
# In staging/production the app REFUSES TO START unless every backend above is its real
# implementation, Clerk is set, ALLOWED_ORIGINS is an exact-origin list, MFA is required, and
# (production) EVIDENCE_RETENTION_DAYS >= 2555. Because no real CSAM scanner exists yet, a
# deployment cannot boot until one is connected — intentional (CLAUDE.md #7). Dev/test are exempt.
CLERK_REQUIRE_MFA=0            # deployments require 1 (checks the Clerk `fva` session claim)
LOG_LEVEL=INFO
LOG_JSON=0                     # deployments set 1 (structured JSON logs; always scrubbed)
SECURITY_HEADERS_ENABLED=0     # deployments set 1
RATE_LIMIT_ENABLED=0           # deployments set 1
RATE_LIMIT_WRITES_PER_MIN=60
MAX_REQUEST_BYTES=30000000     # hard cap on any request body (413 past this)
SENTRY_DSN=                    # error tracking is off unless set; needs the [obs] extra
SENTRY_TRACES_SAMPLE_RATE=0.0
# Production evidence object-lock retention floor is 7 years; override only with a documented reason.
# EVIDENCE_RETENTION_OVERRIDE_REASON=

# ── Frontend (Vite; must be prefixed VITE_) ───────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_CLERK_PUBLISHABLE_KEY=
